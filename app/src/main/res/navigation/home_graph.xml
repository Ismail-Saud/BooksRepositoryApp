<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_graph"
    app:startDestination="@id/booksCategoryFragment">

    <fragment
        android:id="@+id/booksCategoryFragment"
        android:name="com.example.booksrepositoryapp.ui.bookCategory.BooksCategoryFragment"
        android:label="Books">
        <action
            android:id="@+id/action_category_to_booksList"
            app:destination="@id/booksListFragment"/>
    </fragment>

    <fragment
        android:id="@+id/booksListFragment"
        android:name="com.example.booksrepositoryapp.ui.booksList.BooksListFragment"
        android:label="Books">
        <action
            android:id="@+id/action_booksList_to_bookDetails"
            app:destination="@id/booksDetailsFragment"/>
    </fragment>

    <fragment
        android:id="@+id/booksDetailsFragment"
        android:name="com.example.booksrepositoryapp.ui.bookDetails.BookDetailsFragment"
        android:label="Books"/>

    <fragment
        android:id="@+id/addToCartFragment"
        android:name="com.example.booksrepositoryapp.ui.addToCart.AddToCartFragment"
        android:label="Cart">
        <action
            android:id="@+id/add_to_cart_to_checkout"
            app:destination="@id/checkoutFragment"/>
    </fragment>

    <fragment
        android:id="@+id/checkoutFragment"
        android:name="com.example.booksrepositoryapp.ui.checkout.CheckoutFragment"
        android:label="Cart">
        <action
            android:id="@+id/checkout_to_success"
            app:destination="@id/successFragment"/>
        <action
            android:id="@+id/checkout_to_addressList"
            app:destination="@id/addressListFragment"/>
    </fragment>

    <fragment
        android:id="@+id/addressListFragment"
        android:name="com.example.booksrepositoryapp.ui.addressScreen.AddressListFragment"
        android:label="Cart">
    </fragment>

    <fragment
        android:id="@+id/successFragment"
        android:name="com.example.booksrepositoryapp.ui.successPayment.PaymentSuccessFragment"
        android:label="Cart"/>


    <fragment
        android:id="@+id/accountDetailsFragment"
        android:name="com.example.booksrepositoryapp.ui.accountDetails.AccountDetailsFragment"
        android:label="Account"/>
</navigation>