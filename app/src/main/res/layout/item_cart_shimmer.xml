<?xml version="1.0" encoding="utf-8"?>

<com.facebook.shimmer.ShimmerFrameLayout
    android:id="@+id/shimmerLayout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="122dp"
    android:layout_marginBottom="14dp">


    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="122dp"

        app:cardBackgroundColor="#111111"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp">


        <androidx.constraintlayout.widget.ConstraintLayout

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF">


            <!-- Book Image -->
            <View
                android:id="@+id/shimmerBookImage"
                android:layout_width="84dp"
                android:layout_height="match_parent"
                android:background="#DDDDDD"

                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>


            <!-- Category -->
            <View
                android:id="@+id/shimmerCategory"
                android:layout_width="60dp"
                android:layout_height="10dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="15dp"
                android:background="#DDDDDD"

                app:layout_constraintStart_toEndOf="@id/shimmerBookImage"
                app:layout_constraintTop_toTopOf="parent"/>


            <!-- Title line 1 -->
            <View
                android:id="@+id/shimmerTitle"
                android:layout_width="150dp"
                android:layout_height="14dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:background="#DDDDDD"

                app:layout_constraintStart_toEndOf="@id/shimmerBookImage"
                app:layout_constraintTop_toBottomOf="@id/shimmerCategory"/>


            <!-- Title line 2 -->
            <View
                android:id="@+id/shimmerTitleSecond"
                android:layout_width="110dp"
                android:layout_height="14dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="4dp"
                android:background="#DDDDDD"

                app:layout_constraintStart_toEndOf="@id/shimmerBookImage"
                app:layout_constraintTop_toBottomOf="@id/shimmerTitle"/>


            <!-- Author -->
            <View
                android:id="@+id/shimmerAuthor"
                android:layout_width="90dp"
                android:layout_height="9dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="5dp"
                android:background="#DDDDDD"

                app:layout_constraintStart_toEndOf="@id/shimmerBookImage"
                app:layout_constraintTop_toBottomOf="@id/shimmerTitleSecond"/>


            <!-- Remove Button -->
            <View
                android:id="@+id/shimmerRemove"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/shimmer_circle"

                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>


            <!-- Quantity minus -->
            <View
                android:id="@+id/shimmerMinus"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/shimmer_circle"
                app:layout_constraintStart_toStartOf="@id/shimmerTitle"
                app:layout_constraintBottom_toBottomOf="parent"/>


            <!-- Quantity number -->
            <View
                android:id="@+id/shimmerQuantity"
                android:layout_width="28dp"
                android:layout_height="14dp"
                android:layout_marginStart="8dp"
                android:background="#DDDDDD"

                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/shimmerMinus"/>


            <!-- Quantity plus -->
            <View
                android:id="@+id/shimmerPlus"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/shimmer_circle"

                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/shimmerQuantity"/>


            <!-- Price -->
            <View
                android:id="@+id/shimmerPrice"
                android:layout_width="55dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:background="#DDDDDD"

                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>


        </androidx.constraintlayout.widget.ConstraintLayout>


    </com.google.android.material.card.MaterialCardView>


</com.facebook.shimmer.ShimmerFrameLayout>